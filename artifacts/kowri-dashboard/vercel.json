{
  "framework": "vite",
  "installCommand": "npx --yes pnpm@10.33.0 install --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.33.0 --filter @workspace/kowri-dashboard run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
