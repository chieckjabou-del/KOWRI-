# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://kowri:kowri@localhost:5432/kowri
# DATABASE_REPLICA_URL=
# READ_REPLICA_ENABLED=false

# TLS to PostgreSQL: automatic in production for non-local hosts. Force with
# "require", turn off with "disable"; set DATABASE_SSL_REJECT_UNAUTHORIZED=false
# only for providers with a self-signed chain.
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=25

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Browser origins allowed to call the API cross-origin (comma-separated). Empty
# means: every origin outside production, none in production (the API serves
# the front-ends itself, so same-origin calls never need CORS).
# CORS_ORIGINS=https://app.kowri.io,https://admin.kowri.io
# Maximum JSON body (KYC documents are base64 in the body).
# JSON_BODY_LIMIT=2mb
# Keep-alive self-request for hosts that sleep idle processes (off by default).
# SELF_PING=false
# Seconds allowed for in-flight requests to finish on SIGTERM before exit.
# SHUTDOWN_TIMEOUT_S=15

# ── Secrets (see docs/SECURITY_SECRETS.md for generation and rotation) ─────
# HMAC key for signed internal requests. Required in production, >= 32 chars.
#   openssl rand -hex 32
SIGNING_SECRET=

# First back-office account, read once at boot while no admin exists.
# Remove both lines after the first successful login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=

# Legacy shared admin key (X-Admin-Key). Optional; keep only during migration
# to per-operator accounts, then unset it.
# ADMIN_API_KEY=

# Abort startup in production when a secret is missing or weak (default true).
# SECRETS_STRICT=true

# Second factor (TOTP) for operators. Default: required in production. When
# required, a session without a verified code — and the legacy shared key —
# only carries read permissions; every write (cash-in, KYC, fees, kill
# switches) needs an enrolled operator who logged in with their code.
# ADMIN_MFA_REQUIRED=true
# MFA_ISSUER=AKWE

# Demo fixtures (20 users with PIN 1234, funded wallets) are created on an
# empty database outside production only. Never enable this in production.
# ALLOW_DEMO_SEED=false

# ── Cash-in (money creation) — maker-checker limits ────────────────────────
# All figures in XOF-equivalent (other currencies converted at the published
# rate). Defaults are proposals to be validated by the business; see
# AKWE_P0_FINANCIAL_CONTROL_GATE.md. Approval always needs a second named
# operator; at or above the threshold a third distinct operator signs.
# CASH_IN_MAX_PER_OPERATION=10000000
# CASH_IN_SECOND_APPROVAL_THRESHOLD=1000000
# CASH_IN_DAILY_LIMIT_PER_OPERATOR=50000000
# CASH_IN_DAILY_LIMIT_PER_BENEFICIARY=20000000
# CASH_IN_DAILY_LIMIT_PLATFORM=500000000
# CASH_IN_EXPIRY_HOURS=24

# ── Identity documents at rest ─────────────────────────────────────────────
# AES-256-GCM key for KYC documents stored in PostgreSQL. Required in
# production (32 bytes hex):  openssl rand -hex 32
KYC_ENCRYPTION_KEY=

# ── Phone verification (OTP) before registration ───────────────────────────
# "required" (default in production) or "optional" (default elsewhere).
# PHONE_VERIFICATION=required
# SMS delivery: "log" (prints, dev), "http" (POST {to,message} to a gateway), "none".
# SMS_PROVIDER=http
# SMS_WEBHOOK_URL=https://sms-gateway.example/send
# SMS_WEBHOOK_TOKEN=
# Days an expired or revoked session row is kept before the daily purge.
# SESSION_RETENTION_DAYS=7

# ── Demo modules without a real backing ────────────────────────────────────
# settlements, clearing, connectors, regions, failure-sim answer 503
# MODULE_DISABLED in production unless listed here ("all", "none" or a list).
# Outside production they are all on.
# EXPERIMENTAL_MODULES=none

# ── Product tuning ──────────────────────────────────────────────────────────
# TONTINE_LEAVE_PENALTY_PCT=10
# OUTBOX_ENABLED=false
