# ── AKWÊ — controlled launch configuration ──────────────────────────────────
# Every variable below is read by the API server at boot. In production the
# secrets review (artifacts/api-server/src/lib/secretsCheck.ts) refuses to
# start when a line marked REQUIRED is missing or invalid, unless
# SECRETS_STRICT=false is set (never in production). Values here are examples;
# the amounts are the limits proposed in AKWE_LAUNCH_READINESS_GATE.md and
# remain DECISION REQUIRED until the business signs them.

NODE_ENV=production
PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Application role, not the owner role (docs/DEPLOYMENT.md).
DATABASE_URL=postgres://akwe_app:CHANGE_ME@db.internal:5432/akwe
# TLS on by default in production; "disable" only on a private network.
# DATABASE_SSL=require

# ── Secrets ─────────────────────────────────────────────────────────────────
# REQUIRED, ≥ 32 characters: request signatures, alert signatures, dev key derivation.
SIGNING_SECRET=CHANGE_ME_openssl_rand_hex_32
# REQUIRED, 64 hex characters: identity documents at rest. Escrow it (docs/DISASTER_RECOVERY.md).
KYC_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# Leave UNSET in production: the shared legacy key must not exist once operators have accounts.
# ADMIN_API_KEY=
# First boot only, then remove: creates the first super_admin.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# ── Operators ───────────────────────────────────────────────────────────────
# Default true in production: every money-moving operator action needs a verified TOTP session.
ADMIN_MFA_REQUIRED=true

# ── Registration ────────────────────────────────────────────────────────────
PHONE_VERIFICATION=required
# REQUIRED with PHONE_VERIFICATION=required.
SMS_PROVIDER=http
SMS_WEBHOOK_URL=https://sms-gateway.example/send
SMS_WEBHOOK_TOKEN=CHANGE_ME

# ── Launch scope (REQUIRED) ─────────────────────────────────────────────────
# LAUNCH_MODULES lists the OPTIONAL financial modules that are open. It never
# turns the core off. Read "none" as "core only":
#
#   CORE — always ON in every configuration, governed only by the kill
#   switches (cash_in, outbound_transfers, all):
#     registration + OTP, KYC, wallets, balances, transaction history,
#     internal transfers between customers, manual cash-in under
#     maker-checker + MFA, platform treasury (fed by cash-in only),
#     reconciliation report, alerting, back-office.
#
#   OPTIONAL — OFF unless named here, at the routes AND inside the services:
#     credit, agents, creator_earnings, pools, insurance, savings, tontines,
#     fx (currency conversion + diaspora), cash_out.
#
#   none                          → CORE ONLY = the controlled financial canary
#   tontines,savings              → core + these two
#   all                           → everything (never in production without
#                                   a gate per module)
LAUNCH_MODULES=none
# Prototype modules (settlements, connectors, clearing, regions, failure-sim). Leave unset.
# EXPERIMENTAL_MODULES=

# ── Cash-in limits (REQUIRED, XOF-equivalent) ───────────────────────────────
# DECISION REQUIRED: these are the proposed canary values, not business-approved.
CASH_IN_MAX_PER_OPERATION=2000000
CASH_IN_SECOND_APPROVAL_THRESHOLD=500000
CASH_IN_DAILY_LIMIT_PER_OPERATOR=10000000
CASH_IN_DAILY_LIMIT_PER_BENEFICIARY=5000000
CASH_IN_DAILY_LIMIT_PLATFORM=50000000
CASH_IN_DAILY_COUNT_PER_BENEFICIARY=5
CASH_IN_EXPIRY_HOURS=24

# ── Alerting (REQUIRED) ─────────────────────────────────────────────────────
# Every reconciliation anomaly, kill switch change and expired cash-in is
# POSTed here as JSON, signed with SIGNING_SECRET (X-Akwe-Signature).
ALERT_WEBHOOK_URL=https://alerts.example/akwe

# ── Web ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.akwe.example,https://admin.akwe.example
# Never in production: demo accounts with a known PIN.
# ALLOW_DEMO_SEED=false
